<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:c="urn:cloudmigration:common:v1" targetNamespace="urn:cloudmigration:application:v1" elementFormDefault="qualified">
<xs:import namespace="urn:cloudmigration:common:v1" schemaLocation="common.xsd"/>
<xs:element name="application"><xs:complexType><xs:sequence>
