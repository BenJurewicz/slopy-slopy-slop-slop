<xs:element name="state" type="c:ApplicationState" minOccurs="1" maxOccurs="1"/>
<xs:element name="submittedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"/>
<xs:element name="company" type="c:Company" minOccurs="1" maxOccurs="1"/>
